#!/usr/bin/env bash
set -euo pipefail
usage() { echo "Usage: $0 baseline|pgo [-- workload-command ...]" >&2; }
mode=${1:-}
case "$mode" in
    baseline|pgo) shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; exit 2 ;;
esac
if [[ ${1:-} == -- ]]; then shift; fi
if [[ $mode == pgo && $# == 0 ]]; then usage; exit 2; fi
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$root"
binary=${PERF_BINARY:-template}
if [[ $mode == baseline ]]; then
    alr build --release -- -f --subdirs=pgo-baseline
    echo "Baseline: $root/bin/pgo-baseline/$binary"
    exit 0
fi
mkdir -p obj/pgo-data
data=$(mktemp -d "$root/obj/pgo-data/run.XXXXXX")
{
    git describe --always --dirty 2>/dev/null || true
    alr exec -- gcc --version
    printf 'workload='
    printf '%q ' "$@"
    printf '\n'
} > "$data/inputs.txt"
# GCC keys counters to object paths: generation/use share --subdirs, and -f
# forces recompilation when switching phases. Normal builds remain separate.
alr build --release -- -f --subdirs=pgo \
    -cargs "-fprofile-generate=$data" -largs "-fprofile-generate=$data"
"$@" "$root/bin/pgo/$binary"
alr build --release -- -f --subdirs=pgo \
    -cargs "-fprofile-use=$data" -Werror=missing-profile -Werror=coverage-mismatch \
    -largs "-fprofile-use=$data"
echo "Profiles and input record: $data"
echo "Optimized: $root/bin/pgo/$binary"
