with "config/template_tests_config.gpr";
project Template_Tests is

    for Source_Dirs use ("src/", "config/");
    for Object_Dir use "obj/" & Template_Tests_Config.Build_Profile;
    for Create_Missing_Dirs use "True";
    for Exec_Dir use "bin";
    for Main use ("tests_main.adb");

    package Compiler is
        for Default_Switches ("Ada") use Template_Tests_Config.Ada_Compiler_Switches;
    end Compiler;

    package Binder is
        for Switches ("Ada") use ("-Es"); --  Symbolic traceback
    end Binder;

    package Format is
        for Width ("Ada") use "100";
        for Indentation ("Ada") use "4";
        for Indentation_Continuation ("Ada") use "4";
    end Format;

end Template_Tests;
